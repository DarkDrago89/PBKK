{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "Jalankan CI4 (localhost:8080)",
      "appliesTo": "/",
      "type": "launch",
      "workingDirectory": "${workspaceRoot}",
      "command": "${env.COMSPEC}",
      "args": [ "/c", "jalankan.bat" ]
    },
    {
      "taskLabel": "Lihat Daftar Route (php spark routes)",
      "appliesTo": "/",
      "type": "default",
      "workingDirectory": "${workspaceRoot}",
      "command": "${env.COMSPEC}",
      "args": [ "/c", "php spark routes" ]
    }
  ]
}

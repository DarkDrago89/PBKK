<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student Management System"
    Width="1200"
    Height="750"
    MinWidth="1000"
    MinHeight="650"
    Background="#F4F6FA"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Kartu putih -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E4EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                Background="#1565C0"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="Manage student data"
                           Foreground="White"
                           FontSize="14"
                           Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- ================= FORM + INFORMASI ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Form Input -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="NIM" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Form.NIM, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Nama" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Form.Nama, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Jurusan" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding JurusanOptions}"
                                      SelectedItem="{Binding Form.Jurusan}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding GenderOptions}"
                                      SelectedItem="{Binding Form.Gender}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Form.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Simpan"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0"/>
                        <Button Content="Reset"
                                Command="{Binding ResetCommand}"
                                Padding="20,10"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,12,0,0"
                               Foreground="#C62828"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Informasi / Statistik -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="INFORMASI"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Total Mahasiswa"
                               Style="{StaticResource StatLabel}"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding TotalStudents}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#1565C0"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Informatika" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalInformatika}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sistem Informasi" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalSistemInformasi}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Laki-laki" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalLakiLaki}" Style="{StaticResource StatValue}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Perempuan" Style="{StaticResource StatLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalPerempuan}" Style="{StaticResource StatValue}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= SEARCH ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Cari berdasarkan NIM, Nama, atau Jurusan (Enter untuk mencari)"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Cari"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="25,10"/>
            </Grid>
        </Border>

        <!-- ================= DATAGRID ================= -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
            <DataGrid ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#ECEFF1"
                      AlternatingRowBackground="#F7F9FC"
                      BorderThickness="0"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="100"/>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="160"/>
                    <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="110"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTemplateColumn Header="Aksi" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Edit"
                                            Style="{StaticResource SmallButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Delete"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>

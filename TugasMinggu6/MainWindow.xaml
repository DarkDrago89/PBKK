<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="500"
        Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <TextBlock Text="Student Registration"
                       FontSize="26"
                       FontWeight="Bold"/>
            <Button Content="Refresh"
                    Width="100"
                    Margin="30,0,0,0"
                    Click="RefreshButton_Click"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="NIM"/>
                        <TextBox x:Name="NimTextBox" Height="24"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Nama"/>
                        <TextBox x:Name="NameTextBox" Height="24"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Program Studi"/>
                        <ComboBox x:Name="ProgramComboBox"
                                  Height="24"
                                  DisplayMemberPath="ProgramName"
                                  SelectedValuePath="ProgramId"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Tanggal Lahir"/>
                        <DatePicker x:Name="BirthDatePicker" Height="24"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Alamat"/>
                        <TextBox x:Name="AddressTextBox" Height="24"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="No. Telepon"/>
                        <TextBox x:Name="PhoneTextBox" Height="24"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            x:Name="AddButton"
                            Content="Tambah Siswa"
                            Width="120"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Click="AddButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <DataGrid x:Name="StudentDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding StudentId}"
                                    Width="60"/>
                <DataGridTextColumn Header="NIM"
                                    Binding="{Binding NIM}"
                                    Width="100"/>
                <DataGridTextColumn Header="Nama"
                                    Binding="{Binding Name}"
                                    Width="180"/>
                <DataGridTextColumn Header="Program Studi"
                                    Binding="{Binding ProgramName}"
                                    Width="150"/>
                <DataGridTextColumn Header="Tanggal Lahir"
                                    Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}"
                                    Width="110"/>
                <DataGridTextColumn Header="No. Telepon"
                                    Binding="{Binding PhoneNumber}"
                                    Width="130"/>
                <!-- Mini Challenge 1 -->
                <DataGridTextColumn Header="Alamat"
                                    Binding="{Binding Address}"
                                    Width="250"/>
                <!-- Mini Challenge 2 -->
                <DataGridTextColumn Header="Dibuat"
                                    Binding="{Binding CreatedAt}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Mini Challenge 3 -->
        <TextBlock x:Name="TotalTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Text="Total Mahasiswa: 0"/>
    </Grid>
</Window>
